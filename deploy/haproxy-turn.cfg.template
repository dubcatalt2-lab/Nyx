global
    log /dev/log local0
    user haproxy
    group haproxy
    maxconn 512

defaults
    mode tcp
    timeout connect 5s
    timeout client 1h
    timeout server 1h
    timeout tunnel 1h

frontend nyx_tls
    bind :::443 v4v6
    tcp-request inspect-delay 5s
    tcp-request content accept if { req.ssl_hello_type 1 }
    use_backend nyx_turn if { req.ssl_sni -i __NYX_TURN_DOMAIN__ }
    default_backend nyx_https

backend nyx_https
    server caddy 127.0.0.1:8443 send-proxy-v2

backend nyx_turn
    server coturn 127.0.0.1:5349
