# Reuse HTTP connections instead of filling Node's TCP accept queue under load.
# Keep cached sockets below Node's default five-second keep-alive timeout.
upstream nyx_origin_pool {
    server 127.0.0.1:8080;
    keepalive 64;
    keepalive_requests 1000;
    keepalive_timeout 4s;
}

map $http_upgrade $nyx_connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 80;
    listen [::]:80;
    server_name __NYX_DOMAIN__ www.__NYX_DOMAIN__;
    server_tokens off;

    # Profile media is chunked below this limit; keep a little JSON overhead.
    client_max_body_size 2m;

    location / {
        proxy_pass http://nyx_origin_pool;
        proxy_http_version 1.1;

        # cloudflare-real-ip.conf changes $remote_addr only for trusted
        # Cloudflare source networks. Always overwrite client-supplied headers.
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header CF-Connecting-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $nyx_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
