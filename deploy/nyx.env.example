# Nyx production environment for systemd.
# The OVH installer replaces __NYX_ROOT__ and __NYX_DOMAIN__.
# Keep real secrets only in /etc/nyx/nyx.env, never in this repository.

NODE_ENV=production
PORT=8080
NYX_PROJECT_ROOT=__NYX_ROOT__
NYX_STATIC_ROOT=__NYX_ROOT__/dist
NYX_PUBLIC_ORIGIN=https://__NYX_DOMAIN__
NYX_TRUST_PROXY=true
NYX_ALLOWED_ORIGINS=https://__NYX_DOMAIN__,https://www.__NYX_DOMAIN__
NYX_CUSTOM_HOST_IPS=
NYX_CHAT_ATTACHMENT_ROOT=/var/lib/nyx/chat-attachments

# Optional authenticated TURN relay for voice calls across restrictive networks.
# Use the VPS IP or an unproxied DNS hostname; Cloudflare does not proxy TURN.
# Generate the secret on the VPS with: openssl rand -hex 32
# NYX_TURN_URLS='turn:YOUR_VPS_IP:3478?transport=udp,turn:YOUR_VPS_IP:3478?transport=tcp'
# NYX_TURN_SHARED_SECRET='replace-with-random-server-only-secret'
# NYX_TURN_TTL_SECONDS=3600
# Optional TURN-over-TLS fallback. The hostname in NYX_TURN_URLS must match the
# certificate. Port 5349 is conventional; TCP 443 requires a dedicated address
# or an L4 multiplexer because Caddy already owns HTTPS on 443.
# NYX_TURN_TLS_PORT=5349
# NYX_TURN_TLS_CERT='/path/to/fullchain.pem'
# NYX_TURN_TLS_KEY='/path/to/private-key.pem'
# NYX_TURN_URLS='turn:YOUR_VPS_IP:3478?transport=udp,turn:YOUR_VPS_IP:3478?transport=tcp,turns:YOUR_TURN_HOST:5349?transport=tcp'

# Leave WISP_URL unset to use the hardened same-host WebSocket endpoint at
# wss://__NYX_DOMAIN__/wisp/. Set it only when retaining an external Wisp service.
# WISP_URL=wss://your-external-wisp.example/wisp/

# Firebase Authentication, profiles, Owner Dashboard, account activity, and IP bans.
# FIREBASE_WEB_API_KEY='replace-with-firebase-web-api-key'
# FIREBASE_PROJECT_ID='replace-with-firebase-project-id'
# FIREBASE_CLIENT_EMAIL='firebase-adminsdk@example.iam.gserviceaccount.com'
# Keep the private key on one line with literal \n sequences as shown.
# FIREBASE_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\nreplace-with-key-content\n-----END PRIVATE KEY-----\n'
# NYX_FOUNDER_PROFILE_ADMIN_UID='replace-with-owner-firebase-uid'

# Paid Link Checker API.
# NYX_LINK_CHECKER_API_KEY='replace-with-paid-link-checker-key'
# Paid Nocturne account used only for its server-side full-registry scan queue.
# NYX_LINK_CHECKER_ACCOUNT_USERNAME='replace-with-nocturne-username'
# NYX_LINK_CHECKER_ACCOUNT_PASSWORD='replace-with-nocturne-password'
# Optional server safeguards for simultaneous Premium full-scan requests.
# NYX_LINK_CHECKER_BULK_CONCURRENCY_PER_USER=12
# NYX_LINK_CHECKER_BULK_CONCURRENCY_GLOBAL=48

# Link Generator access and optional legacy Bunny provider.
# BUNNY_API_KEY='replace-with-bunny-api-key'
# LINK_GENERATOR_ACCESS_CODE='replace-with-private-access-code'
LINK_GENERATOR_MAX_ZONES=100
LINK_GENERATOR_PREMIUM_BATCH_LIMIT=100

# Optional global Nyx JSDelivr publisher. Use a fine-grained GitHub token scoped
# only to this public repository with Contents: Read and write. The token stays
# server-side; users receive only the generated jsDelivr URLs.
# NYX_JSDELIVR_GITHUB_TOKEN='github_pat_replace-with-server-only-token'
# NYX_JSDELIVR_GITHUB_REPOSITORY='owner/public-repository'
# NYX_JSDELIVR_GITHUB_BRANCH='main'

# Optional Google Safe Browsing download reputation checks.
# NYX_SAFE_BROWSING_API_KEY='replace-with-google-safe-browsing-key'

# Optional hosted Stratus cloud-gaming connector. The API key stays server-side
# and is never returned to the browser. For the separate self-hosted service,
# use /etc/nyx/stratus.env instead; Nyx reads that protected file too.
# NYX_STRATUS_API_KEY='replace-with-issued-stratus-key'
# NYX_STRATUS_API_BASE_URL='https://api.stratus.lol'
# NYX_STRATUS_PUBLIC_BASE_URL='https://api.stratus.lol'
# NYX_STRATUS_CATALOG_URL='https://raw.githubusercontent.com/x8rr/stratus-api/main/cloud.json'
# NYX_STRATUS_MAX_ACTIVE_SESSIONS=4
# NYX_STRATUS_CREATE_TIMEOUT_MS=120000


# Optional Nyx AI provider. NYX_AI_API_KEY is the credential Nyx reads.
# NYX_AI_API_KEY='replace-with-ai-api-key'
# NYX_AI_BASE_URL='https://nocturne.lol'
# NYX_AI_ENDPOINT='https://provider.example/v1/chat/completions'
# NYX_AI_MODELS_ENDPOINT='https://provider.example/v1/models'
# NYX_AI_VISION_CACHE_DIR='/var/lib/nyx/vision-models'
# Optional comma-separated model ids to validate when a provider does not expose
# an API-key-authenticated model catalog.
# NYX_AI_MODEL_IDS='provider:model-one,provider:model-two'
# NYX_AI_MODEL_CHATGPT_54_MINI='navy:gpt-5.4-mini'

# Optional second shared provider. When configured, every Nyx AI user can
# select Navy AI without receiving this credential in the browser.
# NYX_NAVY_API_KEY='sk-navy-replace-with-server-only-key'
# Optional shared OpenAI-compatible providers. Their official base URLs are
# built in; set the *_BASE_URL values only if the provider later gives you a
# different endpoint.
# NYX_OFOX_API_KEY='sk-replace-with-server-only-ofox-key'
# NYX_OFOX_BASE_URL='https://api.ofox.ai/v1'
# NYX_TOKENMIX_API_KEY='sk-replace-with-server-only-tokenmix-key'
# NYX_TOKENMIX_BASE_URL='https://api.tokenmix.ai/v1'

# Optional shared Hugging Face Inference Providers token. Enable the token's
# Inference Providers permission. Keep the real value only in /etc/nyx/nyx.env.
# Appears in Nyx AI's provider picker; Code Sandbox prefers it when configured.
# NYX_HUGGINGFACE_API_KEY='hf_replace-with-server-only-token'

# Optional Nyx-issued API-key gateway backed by one server-only Groq credential.
# Generated nyx_ keys are stored as digests in Firestore and never expose this key.
# NYX_GROQ_API_KEY='gsk_replace-with-server-only-groq-key'
# NYX_GROQ_VISION_MODEL='qwen/qwen3.8-27b'
# NYX_GROQ_MODEL_IDS='openai/gpt-oss-120b,llama-3.3-70b-versatile'
# NYX_GROQ_MAX_TOKENS=800
# NYX_API_KEY_REQUESTS_PER_DAY=100
# NYX_API_KEY_REQUESTS_PER_MINUTE=10
# NYX_API_KEY_REGULAR_DAILY_TOKENS=2000
# NYX_AI_TEMPERATURE=0.7
# NYX_AI_MAX_TOKENS=1200
# NYX_AI_REQUESTS_PER_MINUTE=6
# NYX_AI_REQUESTS_PER_DAY=60
# NYX_AI_CONCURRENT_PER_IP=2
# NYX_AI_CONCURRENT_GLOBAL=3
# NYX_AI_MAX_PROMPT_CHARS=4000
# NYX_AI_MAX_CONTEXT_CHARS=24000
# NYX_AI_TIMEOUT_MS=45000
