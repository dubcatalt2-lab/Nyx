# Optional self-hosted Stratus service. Generate the key on the VPS and keep it
# only in /etc/nyx/stratus.env. A blank key keeps the service disabled.
STRATUS_API_KEY=''
STRATUS_PUBLIC_ORIGIN='https://__NYX_DOMAIN__'
STRATUS_PORT=3001
STRATUS_MAX_CONCURRENT_SESSIONS=4
STRATUS_MAX_SESSION_SECONDS=900
STRATUS_CREATE_TIMEOUT_MS=180000
STRATUS_ACCOUNT_POOL_TARGET=1
STRATUS_LIMIT_PER_MINUTE=4
STRATUS_LIMIT_PER_HOUR=20
STRATUS_LIMIT_PER_DAY=80
STRATUS_LIMIT_PER_MONTH=500
STRATUS_SOURCE_URL='https://github.com/dubcatalt2-lab/Nyx/tree/agent/pirate-cove/services/stratus'

# Nyx reads the same STRATUS_API_KEY and settings from this protected file,
# calls the service over loopback, and uses STRATUS_PUBLIC_ORIGIN for embeds.
