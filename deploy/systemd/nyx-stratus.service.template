[Unit]
Description=Nyx self-hosted Stratus cloud-gaming service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nyx
Group=nyx
WorkingDirectory=__NYX_ROOT__/services/stratus
EnvironmentFile=/etc/nyx/stratus.env
Environment=STRATUS_RUNTIME_DIR=/var/lib/nyx-stratus/runtime
ExecStart=/usr/bin/node __NYX_ROOT__/services/stratus/launcher.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
StateDirectory=nyx-stratus
StateDirectoryMode=0750
ReadWritePaths=/var/lib/nyx-stratus
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
LimitNOFILE=65536
TasksMax=256

[Install]
WantedBy=multi-user.target
