[Unit]
Description=Nyx isolated document service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nyx-document
Group=nyx-document
WorkingDirectory=__NYX_ROOT__
EnvironmentFile=/etc/nyx/document.env
ExecStart=/usr/bin/node __NYX_ROOT__/connection/isolated-app.mjs
Restart=on-failure
RestartSec=3
MemoryAccounting=true
MemoryHigh=512M
MemoryMax=768M
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
StateDirectory=nyx-document
StateDirectoryMode=0700
ReadWritePaths=/var/lib/nyx-document
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
