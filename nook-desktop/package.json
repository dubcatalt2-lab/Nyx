{
  "name": "nook-agent",
  "version": "0.1.3",
  "private": true,
  "description": "Nook Agent for Windows",
  "author": "Nook",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:arm64": "electron-builder --win nsis --arm64 --publish never",
    "checksums": "node scripts/checksums.cjs",
    "assets": "node scripts/build-assets.mjs",
    "prebuild:win": "npm run assets",
    "prebuild:arm64": "npm run assets"
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "3.1.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.nyxlearning.nook.agent",
    "productName": "Nook Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "resources/*.ps1"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/nook.ico",
      "artifactName": "Nook-Agent-${version}-windows-${arch}-setup.exe",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Nook Agent",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
